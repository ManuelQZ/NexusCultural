# ===================================================================
# Nexus Cultural Backend - Variables de Entorno de Ejemplo (.env.example)
# Copia este archivo como .env y coloca tus credenciales reales
# ===================================================================

# Base de datos (Por defecto H2 en memoria para desarrollo local)
SPRING_DATASOURCE_URL=jdbc:h2:mem:ecommercedb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_DRIVER=org.h2.Driver
SPRING_JPA_DDL_AUTO=update

# Para PostgreSQL (Local o AWS RDS):
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/dBNexusCultural
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=tu_password
# SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# Clave Secreta para Tokens JWT (mínimo 32 caracteres para HMAC-SHA256)
JWT_SECRET=tu_clave_secreta_jwt_de_al_menos_32_caracteres_aqui

# Firebase (Notificaciones de Correo)
FIREBASE_CONFIG_PATH=classpath:firebase-key-nexus-cultural-sevicio-correo.json

# AWS S3 (Almacenamiento de Imágenes)
AWS_ACCESS_KEY_ID=tu_aws_access_key_aqui
AWS_SECRET_ACCESS_KEY=tu_aws_secret_key_aqui
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=tu_bucket_s3_aqui

# Pasarela de Pagos Wompi (Modo Sandbox / Pruebas)
WOMPI_PUBLIC_KEY=pub_test_tu_llave_publica
WOMPI_PRIVATE_KEY=prv_test_tu_llave_privada
WOMPI_EVENTS_SECRET=test_events_tu_secreto_eventos
WOMPI_INTEGRITY_SECRET=test_integrity_tu_secreto_integridad
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_API_URL=https://sandbox.wompi.co/v1
